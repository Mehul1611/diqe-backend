## Copy to `.env` and fill values.
## Never commit `.env` (it contains secrets).

### Required (LLM)
GROQ_API_KEY=your_groq_api_key_here

### RAG backend (choose one)
# Default is `local` if omitted.
RAG_BACKEND=local

### Optional: HuggingFace token (sometimes helps FastEmbed pull models)
# HF_TOKEN=your_huggingface_token_here

### If RAG_BACKEND=postgres (pgvector)
# PGVECTOR_CONNECTION_STRING=postgresql+psycopg://postgres:password@localhost:5432/diqe_db
# PGVECTOR_TABLE=rag_documents

